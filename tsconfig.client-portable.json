{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": ".test-build/client",
    "baseUrl": ".",
    "paths": {
      "@remotecodex/core": [
        "packages/core/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/terminal-client/src/api.ts",
    "packages/terminal-client/src/controller.ts",
    "packages/terminal-client/src/media-client.ts"
  ]
}
